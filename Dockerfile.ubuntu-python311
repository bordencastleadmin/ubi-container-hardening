ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}

ARG COMPLIANCE_AS_CODE_VERSION=0.1.78
ENV COMPLIANCE_AS_CODE_VERSION=${COMPLIANCE_AS_CODE_VERSION}

ENV BUILDER=/tmp/builder

# Install Python 3.11 (default in Ubuntu 22.04)
RUN apt-get update -y && \
    apt-get install -y python3.11 python3.11-venv python3-pip && \
    ln -sf /usr/bin/python3.11 /usr/bin/python3 && \
    ln -sf /usr/bin/python3.11 /usr/bin/python

RUN mkdir ${BUILDER}
WORKDIR ${BUILDER}
COPY --chmod=0755 scripts/install-dependencies.sh ${BUILDER}/install-dependencies.sh
RUN ${BUILDER}/install-dependencies.sh --version ${COMPLIANCE_AS_CODE_VERSION}

COPY --chmod=0755 scripts/cleanup-apt.sh ${BUILDER}/cleanup-apt.sh
RUN ${BUILDER}/cleanup-apt.sh

WORKDIR /

# Arguments for user restoration
ARG FINAL_USER=1001
ARG ORIGINAL_USER=0

# Create non-root user if needed and fix Python library ownership
RUN if [ "${ORIGINAL_USER}" = "0" ]; then \
        echo "Creating non-root user ${FINAL_USER}"; \
        groupadd -g ${FINAL_USER} appuser && useradd -u ${FINAL_USER} -g appuser -m appuser; \
        echo "Fixing Python library ownership for user ${FINAL_USER}"; \
        chown -R ${FINAL_USER}:${FINAL_USER} /usr/local/lib/python* 2>/dev/null || true; \
        chown -R ${FINAL_USER}:${FINAL_USER} /usr/local/bin 2>/dev/null || true; \
        chown -R ${FINAL_USER}:${FINAL_USER} /home/appuser 2>/dev/null || true; \
    fi

# Switch to final user
USER ${FINAL_USER}